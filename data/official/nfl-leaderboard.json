  "metrics": [
    {
      "metric": "Brier score",
      "definition": "Mean squared error of predicted probabilities; lower is better. Skill baseline = 0.25 for a 50/50 coin flip.",
      "source_url": "https://www.nfl.com/stats/",
      "source_label": "NFL.com official stats",
      "status": "FRAMEWORK"
    },
    {
      "metric": "Log loss",
      "definition": "Cross-entropy of predicted probabilities; lower is better; penalises confident wrong calls.",
      "source_url": "https://www.nfl.com/stats/",
      "source_label": "NFL.com official stats",
      "status": "FRAMEWORK"
    },
    {
      "metric": "ROI",
      "definition": "Return on turnover: (profit or loss) / total stake across settled bets.",
      "source_url": "https://www.nfl.com/stats/",
      "source_label": "NFL.com official stats",
      "status": "FRAMEWORK"
    },
    {
      "metric": "Hit rate",
      "definition": "Share of settled bets that win, by bet type.",
      "source_url": "https://www.nfl.com/stats/",
      "source_label": "NFL.com official stats",
      "status": "FRAMEWORK"
    },
    {
      "metric": "Skill vs. luck",
      "definition": "Significance test of performance vs. a no-skill baseline; separates selective skill from variance.",
      "source_url": "https://www.nfl.com/rulebook/",
      "source_label": "NFL.com official playing rules",
      "status": "FRAMEWORK"
    },
    {
      "metric": "Sample size",
      "definition": "Count of settled, out-of-sample bets; gates ranking until the minimum is met.",
      "source_url": "https://www.nfl.com/stats/",
      "source_label": "NFL.com official stats",
      "status": "FRAMEWORK"
    }
  ],
